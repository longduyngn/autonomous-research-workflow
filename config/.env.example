# ============================================================================
# Antigravity Autonomous Workspace - Environment Configuration (.env)
# Copy this file to .env and fill in the credentials you wish to enable.
# Headless Antigravity CLI (`agy`) does NOT require an API key if logged in!
# ============================================================================

# --- Messaging Gateways ---
# Discord (Outgoing Webhook & Incoming Bot Token)
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Zalo Official Account (OA)
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_SECRET_KEY=
ZALO_DEFAULT_USER_ID=

# Facebook Messenger Platform
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=antigravity_verify_token
MESSENGER_DEFAULT_USER_ID=

# --- Optional Alternative LLM Providers (Only needed if a role switches off `agy`) ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Colab & Kaggle Cloud Notebook MCP Credentials ---
# Get your Kaggle API key from https://www.kaggle.com/settings -> "Create New Token"
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional: URL for a running Colab/Jupyter backend runtime
COLAB_RUNTIME_URL=

# --- Queue ingress and authorized human approvals ---
WORKFLOW_WEBHOOK_TOKEN=
DISCORD_ALLOWED_USER_IDS=

# --- Personal Colab official browser bridge (not an arbitrary runtime URL) ---
COLAB_BRIDGE_TOKEN=
# COLAB_RUNTIME_URL above is legacy; it is never silently treated as local execution.

# --- Optional Kaggle token authentication supported by current Kaggle CLI ---
KAGGLE_API_TOKEN=

# --- Per-provider model tiers (use model IDs available to your account) ---
AGY_RESEARCH_MODEL=
AGY_WORKER_MODEL=
AGY_FAST_MODEL=
CODEX_RESEARCH_MODEL=
CODEX_WORKER_MODEL=
CODEX_FAST_MODEL=
CLAUDE_RESEARCH_MODEL=
CLAUDE_WORKER_MODEL=
CLAUDE_FAST_MODEL=

# --- OpenRouter is optional; models are not guessed or called until configured ---
OPENROUTER_API_KEY=
OPENROUTER_RESEARCH_MODEL=
OPENROUTER_WORKER_MODEL=
OPENROUTER_FAST_MODEL=


DISCORD_GUILD_ID=
DISCORD_CATEGORY_ID=
DISCORD_TASK_PROPOSAL_CHANNEL_ID=
DISCORD_APPROVAL_LIST_CHANNEL_ID=
DISCORD_TASK_LOG_CHANNEL_ID=
